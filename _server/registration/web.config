<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS (Plesk for Windows): only submit.php may be requested from this folder. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config.php" />
          <add segment="config.sample.php" />
          <add segment="schema.sql" />
          <add segment="PHPMailer" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
